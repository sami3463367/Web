# Boighor BD — configuration (everything has a sensible default)
# Copy to .env and export, or set these in your host's environment panel.

# Port the HTTP server binds to (free tiers like Render/Railway inject PORT)
PORT=3000

# Bind address — keep 0.0.0.0 so reverse proxies / sandbox previews can reach it
HOST=0.0.0.0

# Where the local SQLite database file lives (default: ./data) — local mode only
# DATA_DIR=/var/data/boighor

# ---------------------------------------------------------------------------
# Turso / libsql (needed ONLY when deploying serverless, e.g. Vercel)
# When both are set the app switches from embedded SQLite to remote Turso.
# Both are free tiers, no credit card:
#   1. https://turso.com → Sign up with GitHub → Create database
#   2. TURSO_URL  = the "Database URL" (libsql://xxxx.turso.io)
#   3. TURSO_AUTH_TOKEN = `turso db tokens create <db>` or dashboard → Tokens
# ---------------------------------------------------------------------------
# TURSO_URL=libsql://your-shop.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi…
