# Boighor BD — optional configuration (everything has a sensible default)
# Copy to .env and export, or set these in your host's environment panel.

# Port the HTTP server binds to (free tiers like Render/Railway inject PORT)
PORT=3000

# Bind address — keep 0.0.0.0 so reverse proxies / sandbox previews can reach it
HOST=0.0.0.0

# Where the SQLite database file lives (default: ./data)
# DATA_DIR=/var/data/boighor
